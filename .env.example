# Doubao Ark Vision API
ARK_API_KEY=your_api_key_here
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VLM_MODEL=ep-20260420011113-6jvmx
VLM_FP_CONFIDENCE_THRESHOLD=0.8

# VLM 请求选项
# 思考模式。disabled（默认）关掉思考，单次调用从数百秒降到十几秒；
# 设为 default 则沿用模型自带配置（思考开启）。
VLM_THINKING=disabled
# 单次请求超时（秒）与失败重试次数
VLM_TIMEOUT_S=120
VLM_MAX_RETRIES=1

# Server
HOST=0.0.0.0
PORT=8501
